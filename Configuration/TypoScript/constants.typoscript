plugin.tx_episodeguide {
  persistence {
    # cat=plugin.tx_episodeguide//a; type=int+; label=Default storage PID
    storagePid =
  }

  view {
    # cat=plugin.tx_episodeguide/file; type=string; label=Path to template layouts (FE)
    layoutRootPath = EXT:episode_guide/Resources/Private/Layouts/

    # cat=plugin.tx_episodeguide/file; type=string; label=Path to template partials (FE)
    partialRootPath = EXT:episode_guide/Resources/Private/Partials/

    # cat=plugin.tx_episodeguide/file; type=string; label=Path to template root (FE)
    templateRootPath = EXT:episode_guide/Resources/Private/Templates/
  }
}
