plugin {
  tx_episodeguide {
    persistence {
      storagePid = {$plugin.tx_episodeguide.persistence.storagePid}
    }

    view {
      layoutRootPaths.0 = {$plugin.tx_episodeguide.view.layoutRootPath}

      partialRootPaths {
        0 = {$plugin.tx_episodeguide.view.partialRootPath}
        10 = {$plugin.tx_frontendtemplates.view.partialRootPath}
      }

      templateRootPaths.0 = {$plugin.tx_episodeguide.view.templateRootPath}
    }
  }
}
